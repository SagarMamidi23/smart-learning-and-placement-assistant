{
  "name": "smart-learning-placement",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @slp/shared && npm run build -w @slp/api && npm run build -w @slp/web",
    "lint": "eslint .",
    "typecheck": "npm run build -w @slp/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @slp/shared && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch": "python scripts/fetch_data.py",
    "data:process": "python scripts/process_data.py",
    "seed:domains": "npm run seed:domains -w @slp/api --",
    "seed:opportunities": "npm run seed:opportunities -w @slp/api --",
    "eval:resumes": "npm run eval:resumes -w @slp/api --",
    "data:ingest": "python scripts/ingest_study_material.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
