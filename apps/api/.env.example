PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/slp
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
ML_SERVICE_URL=http://localhost:8000

# Auth (>= 32 chars each in production; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Resume storage: local disk by default; set CLOUDINARY_URL to use Cloudinary instead
UPLOAD_DIR=./uploads
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
MAX_RESUME_BYTES=5242880

# LLM. Pick one provider; swapping is only an env change.
#   groq   -> GROQ_API_KEY   (default model openai/gpt-oss-120b; free tier is capped at 8000 tokens/minute)
#   gemini -> GEMINI_API_KEY (default gemini-2.5-flash; preset not yet tested against a real key)
#   openai -> OPENAI_API_KEY (default gpt-4o-mini; untested)
#   ollama -> no key, local server at http://localhost:11434 (default model llama3.1; untested)
#   custom -> LLM_BASE_URL + LLM_MODEL (+ LLM_API_KEY) for any OpenAI-compatible endpoint
# Put real keys in apps/api/.env (git-ignored), never in this file.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
LLM_TIMEOUT_MS=45000
# Per-user cap on AI-backed requests (discovery, skill gap, learning path)
AI_RATE_LIMIT_PER_HOUR=30

# RAG mentor
ML_SERVICE_URL=http://localhost:8000
MAX_MATERIAL_BYTES=31457280
# Similarity floor for study-material passages (calibrated for bge-small-en-v1.5)
RAG_MIN_SCORE=0.6
RAG_TOP_K=5

# Voice interviews (VAPI). Disabled; the API refuses mode=voice and the UI hides it.
VOICE_ENABLED=false

# First-run setup for hosts with no shell (e.g. free Render). Both are optional and idempotent.
#   AUTO_SEED=true seeds the 12 domains and the opportunity list at startup.
#   BOOTSTRAP_ADMIN_* create the first admin only while no admin exists (remove the password afterwards).
AUTO_SEED=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Require "Authorization: Bearer <token>" on /metrics (16+ characters). Leave unset locally.
# METRICS_TOKEN=
