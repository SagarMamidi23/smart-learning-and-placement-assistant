# Root env used by docker compose. Copy to .env (never commit .env).
NODE_ENV=development
MONGO_URI=mongodb://mongo:27017/slp
JWT_ACCESS_SECRET=change-me-access-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
ML_SERVICE_URL=http://ml:8000
GRAFANA_ADMIN_PASSWORD=change-me
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# LLM (Phase 3). Providers: groq | gemini | openai | ollama | custom. Never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
AI_RATE_LIMIT_PER_HOUR=30

# First run with docker compose: seed domains/opportunities and create an admin without a shell.
# AUTO_SEED=true
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-one
# METRICS_TOKEN=
